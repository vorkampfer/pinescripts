//@version=5
indicator("DSL Oscillator [BigBeluga]")

// ====================================================================================================================}
// ＩＮＰＵＴＳ
// ===================================================================================================================={

// User inputs for customization
len      = input.int(10, "Length")
dsl_mode = input.string("Fast", "DSL Lines Mode", ["Fast", "Slow"]) == "Fast" ? 2 : 1

// Chart enter/exit colors stay fixed.
color_up = #8BD8BD
color_dn = #436cd3

grp_dots = "Signal Dots"
dot_buy_color  = input.color(#8BD8BD, "Buy", group = grp_dots, inline = "dotbuy")
dot_buy_op     = input.int(100, "Opacity", minval = 0, maxval = 100, group = grp_dots, inline = "dotbuy", tooltip = "100 = solid, 0 = invisible")
dot_sell_color = input.color(#436cd3, "Sell", group = grp_dots, inline = "dotsell")
dot_sell_op    = input.int(100, "Opacity", minval = 0, maxval = 100, group = grp_dots, inline = "dotsell", tooltip = "100 = solid, 0 = invisible")

grp_lines = "Line Plots"
line_up_color = input.color(#8BD8BD, "Bullish", group = grp_lines, inline = "lineup")
line_dn_color = input.color(#436cd3, "Bearish", group = grp_lines, inline = "linedn")
line_op       = input.int(100, "Oscillator Opacity", minval = 0, maxval = 100, group = grp_lines, tooltip = "Brightness of the main oscillator line. 100 = solid, 0 = invisible")
dsl_op        = input.int(80, "DSL Lines Opacity", minval = 0, maxval = 100, group = grp_lines, tooltip = "Brightness of the upper and lower DSL lines. 100 = solid, 0 = invisible")

grp_mid = "Midline"
mid_color = input.color(color.gray, "Color", group = grp_mid, inline = "mid")
mid_op    = input.int(100, "Opacity", minval = 0, maxval = 100, group = grp_mid, inline = "mid", tooltip = "Dashed line at 50. 100 = solid, 0 = invisible")

// Condition for a dashed line
bool dashed = bool(bar_index % 2)

// ====================================================================================================================}
// ＣＡＬＣＵＬＡＴＩＯＮＳ
// ===================================================================================================================={

// Calculate RSI with a period of 10
RSI = ta.rsi(close, 10)

// Zero-Lag Exponential Moving Average function
zlema(src, length) =>
    lag      = math.floor((length - 1) / 2)
    ema_data = 2 * src - src[lag]
    ema2     = ta.ema(ema_data, length)
    ema2

// Discontinued Signal Lines
dsl_lines(src, length)=>
    up  = 0.
    dn  = 0.
    up := (src > ta.sma(src, length)) ? nz(up[1]) + dsl_mode / length * (src - nz(up[1])) : nz(up[1])
    dn := (src < ta.sma(src, length)) ? nz(dn[1]) + dsl_mode / length * (src - nz(dn[1])) : nz(dn[1])
    [up, dn]

// Calculate DSL lines for RSI
[lvlu, lvld] = dsl_lines(RSI, len)

// Calculate DSL oscillator using ZLEMA of the average of upper and lower DSL Lines
dsl_osc = zlema((lvlu + lvld) / 2, 10)

// Calculate DSL Lines for the oscillator
[level_up, level_dn] = dsl_lines(dsl_osc, 10)

// Determine color based on oscillator position relative to its DSL Lines
osc_color = color.new(color.from_gradient(dsl_osc, level_dn, level_up, line_dn_color, line_up_color), 100 - line_op)

// ====================================================================================================================}
// ＰＬＯＴ
// ===================================================================================================================={

// Plot upper and lower DSL Lines
plot(level_up, "DSL Upper", color = dashed ? color.new(line_up_color, 100 - dsl_op) : na, editable = false)
plot(level_dn, "DSL Lower", color = dashed ? color.new(line_dn_color, 100 - dsl_op) : na, editable = false)

// Plot the DSL oscillator
plot(dsl_osc, "DSL Oscillator", color = osc_color, linewidth = 2)

// Detect crossovers for signal generation
up = ta.crossover(dsl_osc, level_dn) and dsl_osc < 55
dn = ta.crossunder(dsl_osc, level_up) and dsl_osc > 50

// Plot signals on the oscillator
buy_dot  = color.new(dot_buy_color, 100 - dot_buy_op)
sell_dot = color.new(dot_sell_color, 100 - dot_sell_op)
plotshape(up ? dsl_osc[1] : na, "Buy Dot", shape.circle, location.absolute, buy_dot, -1, "", chart.fg_color, false, size.tiny)
plotshape(dn ? dsl_osc[1] : na, "Sell Dot", shape.circle, location.absolute, sell_dot, -1, "", chart.fg_color, false, size.tiny)

// Plot signals on the chart
plotshape(up, "", shape.triangleup, location.bottom, color_up, 0, "Enter", chart.fg_color, true, size.tiny,
         force_overlay = true)
plotshape(dn, "", shape.triangledown, location.top, color_dn, 0, "Exit", chart.fg_color, true, size.tiny,
         force_overlay = true)

// Color the background on signal occurrences
bgcolor(up ? color.new(color_up, 90) : na, force_overlay = true, editable = false)
bgcolor(dn ? color.new(color_dn, 90) : na, force_overlay = true, editable = false)

// Color candles based on signals
candle_col = up ? color.new(color_up, 0) : dn ? color.new(color_dn, 0) : na

plotcandle(open, high, low, close, "",
     candle_col,
     candle_col,
     bordercolor   = candle_col,
     force_overlay = true,
     editable      = false)

// Plot horizontal lines for visual reference
h = plot(75, display = display.none, editable = false)
m = plot(50, display = display.none, editable = false)
l = plot(25, display = display.none, editable = false)

// Fill areas between horizontal lines
fill(m, h, 120, 50, color_up, na, editable = false)
fill(m, l, 50, -20, na, color_dn, editable = false)

// Midline at the bullish/bearish crossover
plot(50, "Midline", color = dashed ? color.new(mid_color, 100 - mid_op) : na)

// ====================================================================================================================}
