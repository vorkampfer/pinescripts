// Personal-use edit: each fib line, background, midline, and signal color can be set
// from the indicator settings, including transparency. Calculations are unchanged.

//@version=5
indicator("Fibonacci Bands [BigBeluga] Colors", overlay=true, max_lines_count = 500)

// ＩＮＰＵＴＳ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
int   period    = input.int(20, title="Period")
float width     = input.float(1, title="Width", step = 0.1, minval = 0.5, maxval =3)
float price     = input.source(close, title="Source")
bool  hide_ch   = input.bool(false, "Hide Fibonacci Lines", group = "Fibonacci")
float fibRatio1 = input.float(1.618, title="Fibonacci Ratio 1", step = 0.001)
float fibRatio2 = input.float(2.618, title="Fibonacci Ratio 2", step = 0.001)
float fibRatio3 = input.float(4.236, title="Fibonacci Ratio 3", step = 0.001)
int   extend    = input.int(30, "Extend Bands", step = 10, minval = 10, maxval = 350)
bool liq_sweep  = input.bool(true, "Liquidity Sweep")

// Transparency in the color picker is kept. 0 is solid; raise it until a line or fill disappears.
color top3_col = input.color(color.new(#e60060, 50), "100%", inline = "u", group = "Upper fib lines", tooltip = "Color and transparency of the upper 100% line. Use the color picker's transparency to make it bright or invisible.")
color top2_col = input.color(color.new(#e60060, 50), "61.8%", inline = "u", group = "Upper fib lines", tooltip = "Color and transparency of the upper 61.8% line.")
color top1_col = input.color(color.new(#e60060, 80), "38.2%", inline = "u", group = "Upper fib lines", tooltip = "Color and transparency of the upper 38.2% line.")

color bot1_col = input.color(color.new(color.lime, 80), "38.2%", inline = "l", group = "Lower fib lines", tooltip = "Color and transparency of the lower 38.2% line.")
color bot2_col = input.color(color.new(color.lime, 50), "61.8%", inline = "l", group = "Lower fib lines", tooltip = "Color and transparency of the lower 61.8% line.")
color bot3_col = input.color(color.new(color.lime, 50), "100%", inline = "l", group = "Lower fib lines", tooltip = "Color and transparency of the lower 100% line.")

color fill_top_outer = input.color(color.new(#e60060, 90), "Upper 61.8-100%", inline = "fo", group = "Fib background", tooltip = "Background between the upper 61.8% and 100% lines.")
color fill_top_inner = input.color(color.new(#e60060, 100), "Upper 38.2-61.8%", inline = "fo", group = "Fib background", tooltip = "Background between the upper 38.2% and 61.8% lines. Fully transparent by default.")
color fill_bot_inner = input.color(color.new(color.lime, 100), "Lower 38.2-61.8%", inline = "fi", group = "Fib background", tooltip = "Background between the lower 38.2% and 61.8% lines. Fully transparent by default.")
color fill_bot_outer = input.color(color.new(color.lime, 90), "Lower 61.8-100%", inline = "fi", group = "Fib background", tooltip = "Background between the lower 61.8% and 100% lines.")

bool  mid_chart  = input.bool(true, "Chart color", inline = "mid", group = "Midline and signals", tooltip = "On uses the chart text color for the midline, matching the original. Off uses the custom color.")
color mid_custom = input.color(color.white, "Midline", inline = "mid", group = "Midline and signals")
color sig_dn_col = input.color(#e60060, "Down", inline = "sig", group = "Midline and signals", tooltip = "Mean-reversion signal above the upper 100% band.")
color sig_up_col = input.color(color.lime, "Up", inline = "sig", group = "Midline and signals", tooltip = "Mean-reversion signal below the lower 100% band.")

var line l1 = line(na)
var line l2 = line(na)

var line ext_t3 = na
var line ext_t2 = na
var line ext_t1 = na
var line ext_m  = na
var line ext_b1 = na
var line ext_b2 = na
var line ext_b3 = na

var linefill ext_fill_to = na
var linefill ext_fill_ti = na
var linefill ext_fill_bi = na
var linefill ext_fill_bo = na

var label lb_m  = na
var label lb_t3 = na
var label lb_t2 = na
var label lb_t1 = na
var label lb_b1 = na
var label lb_b2 = na
var label lb_b3 = na
// }


// ＣＡＬＣＵＬＡＴＩＯＮＳ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
drop_line(id) =>
    if not na(id)
        line.delete(id)

drop_fill(id) =>
    if not na(id)
        linefill.delete(id)

drop_label(id) =>
    if not na(id)
        label.delete(id)

draw_label(id, n, y, txt1, txt2)=>
    drop_label(id)
    label.new(n, y, str.tostring(txt1, format.percent) + str.tostring(txt2, "  (#.##)"),
         color      = color(na),
         style      = label.style_label_left,
         textcolor  = color.new(chart.fg_color, 10),
         text_font_family = font.family_monospace)

smma(src, length) =>
    var float smma_value = na
    series float sma = ta.sma(src, length)
    if na(smma_value[1])
        smma_value := sma  // Start with SMA for the initial value
    else
        smma_value := (smma_value[1] * (length - 1) + src) / length  // Smooth the value iteratively
    smma_value

series float ATR  = smma(ta.atr(200), 100)
series float smma = smma(price, period)

// Calculate Fibonacci Levels
series float r1 = ATR * fibRatio1 * width
series float r2 = ATR * fibRatio2 * width
series float r3 = ATR * fibRatio3 * width

// Calculate Fibonacci Bands
series float fibTop1  = smma + r1
series float fibTop2  = smma + r2
series float fibTop3  = smma + r3
series float fibBott1 = smma - r1
series float fibBott2 = smma - r2
series float fibBott3 = smma - r3

int          slop_i   = math.round(extend/10)
series float slope    = (smma-smma[slop_i]) / slop_i

series bool mid_trend = smma > smma[1]

sig_dn = mid_trend and ta.pivothigh(4, 1) and high > fibTop3 and ta.crossunder(high, high[1]) and barstate.isconfirmed
sig_up = not mid_trend and ta.pivotlow(4, 1) and low < fibBott3 and ta.crossover(low, low[1]) and barstate.isconfirmed
// }


// ＰＬＯＴ ――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――{
color mid_base  = mid_chart ? chart.fg_color : mid_custom
color mid_color = mid_trend ? mid_base : (bar_index % 2 == 0 ? mid_base : na)

color band_top3 = hide_ch ? na : top3_col
color band_top2 = hide_ch ? na : top2_col
color band_top1 = hide_ch ? na : top1_col
color band_bot1 = hide_ch ? na : bot1_col
color band_bot2 = hide_ch ? na : bot2_col
color band_bot3 = hide_ch ? na : bot3_col

color bg_top_outer = hide_ch ? na : fill_top_outer
color bg_top_inner = hide_ch ? na : fill_top_inner
color bg_bot_inner = hide_ch ? na : fill_bot_inner
color bg_bot_outer = hide_ch ? na : fill_bot_outer

display = hide_ch ? display.none : display.all

pt3 = plot(fibTop3,  title="Fib Top 3",    color=band_top3, linewidth=1, display = display)
pt2 = plot(fibTop2,  title="Fib Top 2",    color=band_top2, linewidth=1, display = display)
pt1 = plot(fibTop1,  title="Fib Top 1",    color=band_top1, linewidth=1, display = display)
plot(smma,           title="Middle SMMA",  color=mid_color, linewidth=1)
pb1 = plot(fibBott1, title="Fib Bottom 1", color=band_bot1, linewidth=1, display = display)
pb2 = plot(fibBott2, title="Fib Bottom 2", color=band_bot2, linewidth=1, display = display)
pb3 = plot(fibBott3, title="Fib Bottom 3", color=band_bot3, linewidth=1, display = display)

fill(pt2, pt3, bg_top_outer)
fill(pt1, pt2, bg_top_inner)
fill(pb1, pb2, bg_bot_inner)
fill(pb2, pb3, bg_bot_outer)

if barstate.islast
    int n1 = bar_index
    int n2 = bar_index + extend

    float ym1 = smma
    float ym2 = ym1 + slope * extend

    float y11 = fibTop1
    float y22  = y11 + slope * extend
    float y111  = fibTop2
    float y222   = y111 + slope * extend
    float y1111   = fibTop3
    float y2222    = y1111 + slope * extend

    float y_11 = fibBott1
    float y_22  = y_11 + slope * extend
    float y_111  = fibBott2
    float y_222   = y_111 + slope * extend
    float y_1111   = fibBott3
    float y_2222    = y_1111 + slope * extend

    drop_fill(ext_fill_to)
    drop_fill(ext_fill_ti)
    drop_fill(ext_fill_bi)
    drop_fill(ext_fill_bo)
    drop_line(ext_t3)
    drop_line(ext_t2)
    drop_line(ext_t1)
    drop_line(ext_m)
    drop_line(ext_b1)
    drop_line(ext_b2)
    drop_line(ext_b3)

    ext_t3 := line.new(n1, y1111, n2, y2222, color = band_top3)
    ext_t2 := line.new(n1, y111,  n2, y222,  color = band_top2)
    ext_t1 := line.new(n1, y11,   n2, y22,   color = band_top1)
    ext_m  := line.new(n1, ym1,   n2, ym2,   color = mid_base, style = mid_trend ? line.style_solid : line.style_dashed)
    ext_b1 := line.new(n1, y_11,   n2, y_22,   color = band_bot1)
    ext_b2 := line.new(n1, y_111,  n2, y_222,  color = band_bot2)
    ext_b3 := line.new(n1, y_1111, n2, y_2222, color = band_bot3)

    ext_fill_to := linefill.new(ext_t3, ext_t2, bg_top_outer)
    ext_fill_ti := linefill.new(ext_t2, ext_t1, bg_top_inner)
    ext_fill_bi := linefill.new(ext_b1, ext_b2, bg_bot_inner)
    ext_fill_bo := linefill.new(ext_b3, ext_b2, bg_bot_outer)

    style_lbl = label.style_label_left
    drop_label(lb_m)
    lb_m := label.new(n2, ym2, str.tostring(ym2, "#.##"), color = color(na), style = style_lbl, textcolor = color.new(mid_base, 40))

    if not hide_ch
        lb_t3 := draw_label(lb_t3, n2, y2222, 100, y2222)
        lb_t2 := draw_label(lb_t2, n2, y222, 61.80, y222)
        lb_t1 := draw_label(lb_t1, n2, y22, 38.2, y22)
        lb_b1 := draw_label(lb_b1, n2, y_22, 38.2, y_22)
        lb_b2 := draw_label(lb_b2, n2, y_222, 61.80, y_222)
        lb_b3 := draw_label(lb_b3, n2, y_2222, 100, y_2222)
    else
        drop_label(lb_t3)
        drop_label(lb_t2)
        drop_label(lb_t1)
        drop_label(lb_b1)
        drop_label(lb_b2)
        drop_label(lb_b3)
        lb_t3 := na
        lb_t2 := na
        lb_t1 := na
        lb_b1 := na
        lb_b2 := na
        lb_b3 := na

if liq_sweep
    if sig_dn
        l1 := line.new(bar_index-1, high[1], bar_index-1, high[1])

    if close < open ? high > l1.get_y2() and open < l1.get_y2() : high > l1.get_y2() and close < l1.get_y2()
        l1.set_x2(bar_index)
        l1.set_color(chart.fg_color)
        l1 := line(na)

    if ta.crossover(close, l1.get_y2())
        l1 := line(na)

    // ----------

    if sig_up
        l2 := line.new(bar_index-1, low[1], bar_index-1, low[1])

    if close < open ? low < l2.get_y2() and close > l2.get_y2() : low < l2.get_y2() and open > l2.get_y2()
        l2.set_x2(bar_index)
        l2.set_color(chart.fg_color)
        l2 := line(na)

    if ta.crossunder(close, l2.get_y2())
        l2 := line(na)

plotchar(sig_dn, "Signal Down", "∘", location.abovebar, sig_dn_col, size = size.tiny)
plotchar(sig_up, "Signal Up", "•", location.belowbar, sig_up_col, size = size.small)
// }
